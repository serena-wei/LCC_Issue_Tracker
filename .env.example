# Copy this file to `.env` and fill in local values.
# Never commit a real `.env` file.
#
# On PythonAnywhere, use:
#   DB_USER=YourPAUsername
#   DB_HOST=YourPAUsername.mysql.pythonanywhere-services.com
#   DB_NAME=YourPAUsername$your_database_name
# (a single $ in DB_NAME is correct)

SECRET_KEY=replace-with-a-long-random-string

DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lcc_issue_tracker_db
